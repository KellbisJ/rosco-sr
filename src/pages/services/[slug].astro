---
import Layout from "../../layouts/Layout.astro";
import CtaButtons from "../../components/CtaButtons.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import QuoteCta from "../../components/QuoteCta.astro";
import StripReveal from "../../components/StripReveal.astro";
import { Check } from "@lucide/astro";
import { services, type Service } from "../../data/services";
import { SITE, nb } from "../../site";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props as { service: Service };
// A compare page shows its first two photos side by side as the hero.
const pair = service.compare ? service.photos.slice(0, 2) : [];
const heroPhoto = service.photos[0];
const morePhotos = service.photos.slice(service.compare ? 2 : 1);
// Share image: the "after" of a pair, the "before" of a reveal, else the photo.
const og = pair[1]
  ? { src: pair[1].src, alt: pair[1].alt }
  : heroPhoto.reveal
    ? { src: heroPhoto.reveal.before, alt: heroPhoto.reveal.beforeAlt }
    : { src: heroPhoto.src, alt: heroPhoto.alt };
const others = services.filter((s) => s.slug !== service.slug);
const what = service.name.toLowerCase();
const pageUrl = `${SITE.url}/services/${service.slug}/`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.name,
    serviceType: service.name,
    url: pageUrl,
    areaServed: { "@type": "City", name: "Perth" },
    provider: { "@id": `${SITE.url}/#business` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Services",
        item: `${SITE.url}/services/`,
      },
      { "@type": "ListItem", position: 3, name: service.name, item: pageUrl },
    ],
  },
];

const crumbLink =
  "inline-block rounded py-2 text-secondary transition-colors hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
const tag =
  "pointer-events-none absolute left-3 top-3 rounded-full bg-ink/75 px-3 py-1 text-xs font-semibold text-white";
const pill =
  "inline-flex min-h-11 items-center rounded-full bg-surface px-5 text-sm font-semibold text-primary ring-1 ring-border transition-colors hover:bg-primary-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
// Figures hug the photo's own shape instead of a column-wide grey box.
const figureFit =
  "mx-auto w-fit max-w-full overflow-hidden rounded-2xl bg-surface shadow-lg ring-1 ring-border";
---

<Layout
  title={service.title}
  description={service.description}
  image={og.src}
  imageAlt={og.alt}
  schema={schema}>
  <section class="bg-bg-base py-10 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm">
        <ol class="flex flex-wrap items-center gap-x-2 text-text-secondary">
          <li><a href="/" class={crumbLink}>Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/services/" class={crumbLink}>Services</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="py-2 font-medium text-text-subtitle">
            {nb(service.name)}
          </li>
        </ol>
      </nav>
      <div
        class="mt-6 grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-2 lg:items-center">
        <div class="max-w-xl">
          <h1
            class="text-4xl font-bold tracking-tight text-balance break-words hyphens-auto text-ink sm:text-5xl">
            {nb(service.heading)}
          </h1>
          <p class="mt-6 text-lg leading-8 text-text-body">{service.lead}</p>
          <CtaButtons class="mt-8" service={what} />
        </div>
        {
          pair.length === 2 ? (
            <figure class="mx-auto w-full max-w-lg overflow-hidden rounded-2xl bg-surface shadow-lg ring-1 ring-border">
              <div class="grid grid-cols-2 gap-px bg-border">
                {pair.map((p) => (
                  <div class="relative aspect-[3/4] bg-surface-alt">
                    <img
                      src={p.src}
                      alt={p.alt}
                      width={p.width}
                      height={p.height}
                      fetchpriority="high"
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                    <span class={tag}>{p.caption}</span>
                  </div>
                ))}
              </div>
              <figcaption class="px-5 py-3 text-sm text-text-secondary">
                Same kitchen, before and after the renovation
              </figcaption>
            </figure>
          ) : heroPhoto.reveal ? (
            <StripReveal
              reveal={heroPhoto.reveal}
              caption={heroPhoto.caption}
              eager
              class="mx-auto w-full max-w-lg"
            />
          ) : (
            <figure class={figureFit}>
              <img
                src={heroPhoto.src}
                width={heroPhoto.width}
                height={heroPhoto.height}
                alt={heroPhoto.alt}
                fetchpriority="high"
                class="block h-auto max-h-[36rem] w-auto max-w-full"
              />
              <figcaption class="w-0 min-w-full px-5 py-3 text-sm text-text-secondary">
                {heroPhoto.caption}
              </figcaption>
            </figure>
          )
        }
      </div>
    </div>
  </section>

  <section class="bg-surface-alt py-20 sm:py-28" aria-labelledby="scope">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-xl">
        <h2
          id="scope"
          class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          {service.listTitle}
        </h2>
        <ul class="mt-8 space-y-4">
          {
            service.list.map((item) => (
              <li class="flex gap-3 text-lg leading-7 text-text-body">
                <Check
                  class="mt-1 h-5 w-5 flex-none text-secondary"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))
          }
        </ul>
        {
          service.stays && (
            <p class="mt-8 border-t border-border pt-6 text-base leading-7 text-text-body">
              <span class="font-semibold text-ink">What stays:</span>{" "}
              {service.stays}
            </p>
          )
        }
      </div>
    </div>
  </section>

  {
    morePhotos.length > 0 ? (
      <section class="bg-bg-base py-20 sm:py-28" aria-labelledby="more-photos">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-xl text-center">
            <h2
              id="more-photos"
              class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
              From real jobs
            </h2>
          </div>
          <ul class="mx-auto mt-12 flex max-w-5xl flex-wrap items-start justify-center gap-8">
            {morePhotos.map((p) => (
              <li class="max-w-full">
                {p.reveal ? (
                  <StripReveal
                    reveal={p.reveal}
                    caption={p.caption}
                    class="w-[min(24rem,calc(100vw-2rem))]"
                  />
                ) : (
                  <figure class={figureFit}>
                    <img
                      src={p.src}
                      width={p.width}
                      height={p.height}
                      alt={p.alt}
                      loading="lazy"
                      decoding="async"
                      class="block h-auto max-h-[32rem] w-auto max-w-full"
                    />
                    <figcaption class="w-0 min-w-full px-5 py-3 text-sm text-text-secondary">
                      {p.caption}
                    </figcaption>
                  </figure>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : (
      <div class="h-px w-full bg-border" />
    )
  }

  <HowItWorks done={service.doneStep} />

  <QuoteCta heading={`Need a quote for ${nb(what)}?`} service={what} />

  <section class="bg-surface-alt py-16 sm:py-20" aria-labelledby="other-jobs">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="other-jobs"
        class="text-center text-2xl font-bold tracking-tight text-ink">
        Other jobs we do
      </h2>
      <ul class="mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-3">
        {
          others.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`} class={pill}>
                {nb(s.name)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
