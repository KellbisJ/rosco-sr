---
import Layout from "../layouts/Layout.astro";

const worksImgs: string[] = [
  "https://ik.imagekit.io/137/rosco-sr/1.webp",
  "https://ik.imagekit.io/137/rosco-sr/6.webp",
  "https://ik.imagekit.io/137/rosco-sr/2.webp",
  "https://ik.imagekit.io/137/rosco-sr/3.webp",
  "https://ik.imagekit.io/137/rosco-sr/12.webp",
  "https://ik.imagekit.io/137/rosco-sr/11.webp",
];

const worksLabels: string[] = [
  "Strip Out — Perth",
  "Strip Out — Perth",
  "Bathroom Removal — Perth",
  "Strip Out — Perth",
  "Surface Prep — Perth",
  "Strip Out — Perth",
];

const worksAlts: string[] = [
  "Strip out work carried out by ROSCO S&R in Perth, Western Australia",
  "Strip out work carried out by ROSCO S&R in Perth, Western Australia",
  "Bathroom removal carried out by ROSCO S&R in Perth, Western Australia",
  "Strip out work carried out by ROSCO S&R in Perth, Western Australia",
  "Surface preparation carried out by ROSCO S&R in Perth, Western Australia",
  "Strip out work carried out by ROSCO S&R in Perth, Western Australia",
];
---

<Layout
  title="ROSCO S&R | Strip Out, Removal & Renovation Services Perth"
  description="ROSCO S&R provides professional strip out, non-structural demolition, kitchen renovations, floor renovations, bathroom and kitchen removal, and surface preparation services across Perth, WA. Get a free quote today.">
  <div class="overflow-hidden bg-bg-base">
    <section class="relative min-h-[560px] sm:min-h-[640px] overflow-hidden bg-bg-base" aria-label="Intro">
      <img
        src="https://ik.imagekit.io/137/rosco-sr/12.webp"
        alt="Surface preparation work by ROSCO S&R in Perth, WA"
        class="hero-photo absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-black/55" aria-hidden="true"></div>
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/45 to-transparent"
        aria-hidden="true"></div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/25"
        aria-hidden="true"></div>
      <div class="relative mx-auto flex max-w-7xl items-center px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
        <div class="max-w-xl">
          <h1 class="text-4xl font-bold tracking-tight sm:text-6xl text-white">
            Professional Strip Out, Removal &amp; Renovation Services in Perth
          </h1>
          <p class="mt-6 max-w-[36rem] text-lg leading-7 text-white/90">
            We strip out kitchens, bathrooms and whole rooms. Tiles, floors and rubbish go
            out, and your place is left clean and ready for the next trade. Homeowner
            jobs right across Perth.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a
              href="/contact"
              class="group inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-all duration-300 hover:bg-primary-hover hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-white">
              Get a Free Quote
              <span
                class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true">
                →
              </span>
            </a>
            <a
              href="/services"
              class="group inline-flex items-center gap-2 text-sm font-semibold leading-6 text-white underline decoration-white/40 underline-offset-4 transition-colors duration-300 hover:text-primary-light focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-white">
              Explore Services
              <span
                class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true">
                →
              </span>
            </a>
          </div>
          <p class="mt-8 text-sm font-medium text-white/70">
            Kitchens · Bathrooms · Floors · Surface prep — Perth, WA
          </p>
        </div>
      </div>
    </section>

    <section class="bg-bg-base py-20 sm:py-28" aria-label="Project gallery">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-xl text-center">
          <h2
            class="text-3xl font-bold tracking-tight sm:text-4xl text-text-primary">
            Our Work
          </h2>
          <p class="mt-4 text-lg leading-7 text-text-body">
            Real photos from recent strip out, removal and renovation jobs around Perth.
          </p>
        </div>
        <div
          class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          role="list"
          aria-label="Recent projects">
          {
            worksImgs.map((src, index) => (
              <div
                class="group relative overflow-hidden rounded-2xl bg-surface-alt shadow-lg ring-1 ring-border aspect-[3/4]"
                role="listitem"
                style={`animation: fade-in-up 0.6s ease-out ${index * 0.1}s both`}>
                <img
                  src={src}
                  alt={worksAlts[index]}
                  class="h-full w-full object-cover transition-all duration-500 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent opacity-85 transition-opacity duration-300 group-hover:opacity-100" />
                <div class="absolute bottom-0 h-1/3 bg-gradient-to-t from-black/75 to-transparent" />
                <div class="absolute bottom-0 left-0 right-0 p-5 translate-y-1 transition-all duration-300 group-hover:translate-y-0">
                  <p class="text-sm font-semibold text-white drop-shadow-md">
                    {worksLabels[index]}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-bg-base py-20 sm:py-28" aria-label="Get a quote">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-xl text-center">
          <h2
            class="text-3xl font-bold tracking-tight sm:text-4xl text-text-primary">
            Need a room stripped out before the work starts?
          </h2>
          <p class="mt-4 text-lg leading-7 text-text-body">
            Tell us what's coming out and when. We'll come back with a free, straight
            quote.
          </p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
            <a
              href="/contact"
              class="group inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/25 transition-all duration-300 hover:bg-primary-hover hover:shadow-xl hover:shadow-primary/30 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary">
              Get a Free Quote
              <span
                class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true">
                →
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero-photo {
    animation: hero-drift 12s ease-out both;
  }
  @keyframes hero-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }
</style>
