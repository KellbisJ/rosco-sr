---
import Layout from "../layouts/Layout.astro";
import CtaButtons from "../components/CtaButtons.astro";
import ServiceCards from "../components/ServiceCards.astro";
import HowItWorks from "../components/HowItWorks.astro";
import QuoteCta from "../components/QuoteCta.astro";
import StripReveal from "../components/StripReveal.astro";
import { fireplaceReveal } from "../data/services";
import { SITE, crop, photo } from "../site";

// Collages are trimmed at the bottom to drop the app watermark.
const works = [
  {
    src: crop("1.webp", 0, 0, 800, 770),
    label: "Pergola removal",
    alt: "Before and after of a pergola taken down beside a Perth home",
  },
  {
    src: photo("4.webp"),
    label: "Scraping back an old floor",
    alt: "Worker scraping the remains of an old floor off a concrete slab in a Perth home",
  },
  {
    src: crop("2.webp", 0, 0, 1280, 1232),
    label: "Wall tiles off, back to render",
    alt: "Bathroom walls before and after tile removal, taken back to render in a Perth home",
  },
  {
    src: photo("Renovations/6257921321014595426.jpg"),
    label: "Floor renovation",
    alt: "Renovated floor in a Perth living room with sliding doors",
  },
  {
    src: photo("12.webp"),
    label: "Surface prep",
    alt: "Worker preparing a bare concrete floor on a Perth job",
  },
  {
    src: photo("11.webp"),
    label: "Stripped back to the slab",
    alt: "Empty room stripped back to a clean concrete slab, Perth",
  },
];
---

<Layout
  title={`Strip Outs Perth | Bathrooms, Kitchens & Floors | ${SITE.name}`}
  description={`Strip outs across Perth: bathrooms, kitchens, floors and tiles. Rubbish gone, site left clean for the next trade. Free quotes. Call or text ${SITE.phone}.`}
  image={fireplaceReveal.before}
  imageAlt={fireplaceReveal.beforeAlt}>
  <section class="bg-bg-base pb-16 pt-10 sm:pb-24 sm:pt-16" aria-labelledby="hero-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="max-w-xl">
          <h1
            id="hero-heading"
            class="text-4xl font-bold tracking-tight text-balance text-ink sm:text-6xl">
            Strip Outs &amp; Removals in Perth
          </h1>
          <p class="mt-6 text-lg leading-8 text-text-body">
            We take out what's going and leave what's staying. Kitchens,
            bathrooms, floors and tiles come out, the rubbish goes with us, and
            your place is left clean for the next trade. Homeowner jobs right
            across Perth.
          </p>
          <CtaButtons class="mt-8" />
        </div>
        <StripReveal
          reveal={fireplaceReveal}
          caption="Mantel off. Fireplace intact."
          eager
          class="mx-auto w-full max-w-md lg:max-w-lg"
        />
      </div>
    </div>
  </section>

  <section class="bg-surface-alt py-20 sm:py-28" aria-labelledby="what-we-do">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-xl text-center">
        <h2
          id="what-we-do"
          class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          What we do
        </h2>
        <p class="mt-4 text-lg leading-7 text-text-body">
          Everything that has to come out before the new work goes in.
        </p>
      </div>
      <div class="mt-12">
        <ServiceCards />
      </div>
    </div>
  </section>

  <section class="bg-bg-base py-20 sm:py-28" aria-labelledby="our-work">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-xl text-center">
        <h2
          id="our-work"
          class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          Our work
        </h2>
        <p class="mt-4 text-lg leading-7 text-text-body">
          Real photos from recent strip out, removal and renovation jobs around Perth.
        </p>
      </div>
      <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-3">
        {
          works.map((work) => (
            <li>
              <figure class="group overflow-hidden rounded-2xl bg-surface shadow-lg ring-1 ring-border">
                <div class="aspect-square overflow-hidden bg-surface-alt">
                  <img
                    src={work.src}
                    alt={work.alt}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-110"
                  />
                </div>
                <figcaption class="px-3 py-3 text-sm font-semibold text-ink sm:px-5 sm:py-4">
                  {work.label}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <HowItWorks />

  <QuoteCta heading="Need a room stripped out before the work starts?" />
</Layout>
