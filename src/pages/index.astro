---
import Layout from "../layouts/Layout.astro";
import CtaButtons from "../components/CtaButtons.astro";
import ServiceCards from "../components/ServiceCards.astro";
import HowItWorks from "../components/HowItWorks.astro";
import QuoteCta from "../components/QuoteCta.astro";
import { SITE, photo } from "../site";

const works = [
  {
    src: photo("1.webp"),
    label: "Pergola removal",
    alt: "Before and after of a pergola taken down beside a Perth home",
  },
  {
    src: photo("6.webp"),
    label: "Fireplace mantel removal",
    alt: "Before and after of a timber fireplace mantel removed with the fireplace left intact, Perth",
  },
  {
    src: photo("2.webp"),
    label: "Wall tiles off, back to render",
    alt: "Bathroom walls before and after tile removal, taken back to render in a Perth home",
  },
  {
    src: photo("3.webp"),
    label: "Shelving removal",
    alt: "Wall shelving and brackets being removed on a Perth job",
  },
  {
    src: photo("12.webp"),
    label: "Surface prep",
    alt: "Worker preparing a bare concrete floor on a Perth job",
  },
  {
    src: photo("11.webp"),
    label: "Stripped back to the slab",
    alt: "Empty room stripped back to a clean concrete slab, Perth",
  },
];
---

<Layout
  title={`Strip Outs Perth | Bathrooms, Kitchens & Floors | ${SITE.name}`}
  description={`Strip outs across Perth: bathrooms, kitchens, floors and tiles. Rubbish gone, site left clean for the next trade. Free quotes. Call or text ${SITE.phone}.`}>
  <div class="overflow-hidden bg-bg-base">
    <section class="relative min-h-[560px] sm:min-h-[640px] overflow-hidden bg-bg-base" aria-label="Intro">
      <img
        src={photo("12.webp")}
        alt={`Surface preparation work by ${SITE.name} in Perth, WA`}
        fetchpriority="high"
        class="hero-photo absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-black/55" aria-hidden="true"></div>
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/45 to-transparent"
        aria-hidden="true"></div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/25"
        aria-hidden="true"></div>
      <div class="relative mx-auto flex max-w-7xl items-center px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
        <div class="max-w-xl">
          <h1 class="text-4xl font-bold tracking-tight sm:text-6xl text-white">
            Strip Outs &amp; Removals in Perth
          </h1>
          <p class="mt-6 max-w-[36rem] text-lg leading-7 text-white/90">
            We strip out kitchens, bathrooms and whole rooms. Tiles, floors and rubbish go
            out, and your place is left clean and ready for the next trade. Homeowner
            jobs right across Perth.
          </p>
          <CtaButtons onDark class="mt-10" />
          <p class="mt-8 text-sm font-medium text-white/70">
            Kitchens · Bathrooms · Floors · Surface prep — Perth, WA
          </p>
        </div>
      </div>
    </section>

    <section class="bg-surface-alt py-20 sm:py-28" aria-labelledby="what-we-do">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-xl text-center">
          <h2
            id="what-we-do"
            class="text-3xl font-bold tracking-tight sm:text-4xl text-text-primary">
            What we do
          </h2>
          <p class="mt-4 text-lg leading-7 text-text-body">
            Everything that has to come out before the new work goes in.
          </p>
        </div>
        <div class="mt-12">
          <ServiceCards />
        </div>
      </div>
    </section>

    <section class="bg-bg-base py-20 sm:py-28" aria-label="Project gallery">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-xl text-center">
          <h2
            class="text-3xl font-bold tracking-tight sm:text-4xl text-text-primary">
            Our Work
          </h2>
          <p class="mt-4 text-lg leading-7 text-text-body">
            Real photos from recent strip out, removal and renovation jobs around Perth.
          </p>
        </div>
        <ul
          class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          aria-label="Recent projects">
          {
            works.map((work, index) => (
              <li style={`animation: fade-in-up 0.6s ease-out ${index * 0.1}s both`}>
                <figure class="group overflow-hidden rounded-2xl bg-surface shadow-lg ring-1 ring-border">
                  <div class="aspect-square overflow-hidden bg-surface-alt">
                    <img
                      src={work.src}
                      alt={work.alt}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                    />
                  </div>
                  <figcaption class="px-5 py-4 text-sm font-semibold text-ink">
                    {work.label}
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <HowItWorks />

    <QuoteCta heading="Need a room stripped out before the work starts?" />
  </div>
</Layout>

<style>
  .hero-photo {
    animation: hero-drift 12s ease-out both;
  }
  @keyframes hero-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }
</style>
