---
import Layout from "../layouts/Layout.astro";
import ServiceCards from "../components/ServiceCards.astro";
import HowItWorks from "../components/HowItWorks.astro";
import QuoteCta from "../components/QuoteCta.astro";
import StripReveal from "../components/StripReveal.astro";
import { ArrowRight, Pause, Play } from "@lucide/astro";
import { pergolaReveal } from "../data/services";
import { SITE, nb, photo, quoteText, smsHref } from "../site";

const video = (id: string, caption: string) => ({
  src: photo(`${id}.mp4`),
  poster: photo(`${id}.mp4/ik-thumbnail.jpg?tr=so-8,w-640`),
  caption,
});

// Captions say only what the footage shows.
const videos = [
  video("video6219997081453470100", "Breaking up an old tiled floor"),
  video("video6305415180582919045", "Cutting concrete"),
];

const kitchen = (id: string, stage: "Before" | "After") => ({
  src: photo(`Renovations/${id}.jpg`),
  category: `Kitchen: ${stage}`,
  alt:
    stage === "Before"
      ? "Perth kitchen before renovation, with old cream cabinets and tiles"
      : "The same Perth kitchen after renovation, with new cabinets and a marble-look splashback",
});

const floor = (id: string) => ({
  src: photo(`Renovations/${id}.jpg`),
  category: "Floor Renovation",
  alt: "Renovated floor in a Perth home",
});

// The two kitchen "before" shots and two "after" shots are the same kitchen.
const renovations = [
  kitchen("6257921321014595423", "Before"),
  kitchen("6257921321014595424", "Before"),
  kitchen("6257921321014595405", "After"),
  kitchen("6257921321014595422", "After"),
  floor("6257921321014595431"),
  floor("6257921321014595429"),
  floor("6257921321014595426"),
  floor("6257921321014595430"),
  floor("6257921321014595428"),
  floor("6257921321014595427"),
  floor("6257921321014595433"),
  floor("6257921321014595432"),
];

const pageDescription = `Bathroom strip outs, kitchen removal, floor and tile removal, light demolition and floor grinding across Perth. Free quotes. Call or text ${SITE.phone}.`;

const inlineLink =
  "rounded font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:text-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
---

<Layout
  title={`Strip Out & Removal Services Perth | ${SITE.name}`}
  description={pageDescription}>
  <section class="bg-surface-alt py-14 sm:py-28" aria-labelledby="services-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h1
          id="services-heading"
          class="text-4xl font-bold tracking-tight text-balance text-ink sm:text-5xl">
          Strip Out&nbsp;&amp; Removal Services in Perth
        </h1>
        <p class="mt-4 text-lg leading-8 text-text-body">
          Everything that has to come out before the new work goes in. Pick a
          job to see what's involved.
        </p>
      </div>
      <div class="mx-auto mt-12 max-w-2xl lg:max-w-none">
        <ServiceCards headingTag="h2" />
      </div>
      <p class="mt-4 text-center text-base leading-7 text-text-body">
        Not sure which one?{" "}
        <a href={`tel:${SITE.phoneTel}`} class={inlineLink}>Call</a>{" "}
        or{" "}
        <a href={smsHref(quoteText())} class={inlineLink}>text</a>{" "}
        {SITE.phone} and tell us what's coming out.
      </p>
    </div>
  </section>

  <section class="bg-bg-base py-20 sm:py-28" aria-labelledby="pergola">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="max-w-xl">
          <h2
            id="pergola"
            class="text-3xl font-bold tracking-tight text-balance text-ink sm:text-4xl">
            Pergola down. Garden untouched.
          </h2>
          <p class="mt-4 text-lg leading-8 text-text-body">
            We take out what's going and leave what's staying. The fence,
            paving and garden bed stayed as they were.
          </p>
          <a
            href="/services/non-structural-demolition/"
            class="group mt-8 inline-flex min-h-11 items-center gap-2 rounded-md text-sm font-semibold text-primary transition-colors hover:text-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            See {nb("non-structural")} demolition
            <ArrowRight
              class="h-4 w-4 transition-transform duration-300 motion-safe:group-hover:translate-x-1"
              aria-hidden="true"
            />
          </a>
        </div>
        <StripReveal
          reveal={pergolaReveal}
          caption="Pergola down and gone"
          class="mx-auto w-full max-w-sm"
        />
      </div>
    </div>
  </section>

  <div class="h-px w-full bg-border"></div>

  <section class="bg-bg-base py-20 sm:py-28" aria-labelledby="in-action">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2
          id="in-action"
          class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
          See our work in action
        </h2>
        <p class="mt-4 text-lg leading-8 text-text-body">
          Real footage from recent jobs across Perth.
        </p>
      </div>
      <ul class="mx-auto mt-12 grid max-w-3xl grid-cols-2 gap-3 sm:gap-8">
        {
          videos.map((v) => (
            <li>
              <figure class="overflow-hidden rounded-2xl bg-surface shadow-lg ring-1 ring-border">
                <video
                  src={v.src}
                  poster={v.poster}
                  aria-label={v.caption}
                  class="block aspect-[9/16] w-full bg-ink object-cover"
                  controls
                  playsinline
                  preload="none"
                />
                <figcaption class="px-3 py-3 text-sm font-semibold text-ink sm:px-5">
                  {v.caption}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    id="renovations"
    class="scroll-mt-20 bg-surface-alt py-16 sm:py-24"
    aria-labelledby="renovations-heading">
    <div class="mx-auto mb-10 max-w-7xl px-6 text-center sm:mb-16 lg:px-8">
      <h2
        id="renovations-heading"
        class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Renovations
      </h2>
      <p class="mt-4 text-lg leading-8 text-text-body">
        Kitchens and floors we've renovated around Perth
      </p>
    </div>

    <div
      class="swiper renovations-swiper h-[70vh] min-h-[400px] w-full shadow-2xl sm:h-[80vh] lg:h-[85vh] lg:w-3xl lg:rounded-xl">
      <div class="swiper-wrapper">
        {
          renovations.map((renovation) => (
            <div class="swiper-slide relative h-full w-full">
              <img
                src={renovation.src}
                alt={renovation.alt}
                class="absolute inset-0 h-full w-full object-cover"
                loading="lazy"
              />
              <span class="slide-tag absolute left-4 top-4 rounded-full bg-ink/75 px-3 py-1 text-sm font-semibold text-white">
                {renovation.category}
              </span>
            </div>
          ))
        }
      </div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
      <div class="swiper-pagination"></div>
      <button
        type="button"
        class="slideshow-toggle group absolute bottom-4 left-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-ink/75 text-white transition-colors hover:bg-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        aria-label="Pause slideshow"
        hidden>
        <Pause class="h-4 w-4 group-data-[paused=true]:hidden" aria-hidden="true" />
        <Play
          class="hidden h-4 w-4 group-data-[paused=true]:block"
          aria-hidden="true"
        />
      </button>
    </div>
  </section>

  <HowItWorks />

  <QuoteCta heading="Got a job that needs stripping out?" />
</Layout>

<style is:global>
  .renovations-swiper .swiper-slide {
    background-color: #111827;
    overflow: hidden;
  }

  .renovations-swiper .swiper-button-prev,
  .renovations-swiper .swiper-button-next {
    width: 44px;
    height: 44px;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 9999px;
    color: white !important;
    transition:
      background 0.3s ease,
      transform 0.3s ease;
  }
  .renovations-swiper .swiper-button-prev svg,
  .renovations-swiper .swiper-button-next svg {
    width: 16px;
    height: 16px;
  }
  .renovations-swiper .swiper-button-prev:hover,
  .renovations-swiper .swiper-button-next:hover {
    background: rgba(15, 23, 42, 0.8);
  }
  .renovations-swiper .swiper-button-prev:active,
  .renovations-swiper .swiper-button-next:active {
    transition-duration: 0.1s;
  }
  @media (prefers-reduced-motion: no-preference) {
    .renovations-swiper .swiper-button-prev:hover,
    .renovations-swiper .swiper-button-next:hover {
      transform: scale(1.05);
    }
    .renovations-swiper .swiper-button-prev:active,
    .renovations-swiper .swiper-button-next:active {
      transform: scale(0.95);
    }
  }
  /* Before Swiper starts (or without JS) the arrows can't work: hide them. */
  .renovations-swiper:not(.swiper-initialized) .swiper-button-prev,
  .renovations-swiper:not(.swiper-initialized) .swiper-button-next {
    display: none;
  }

  /* "3 / 12" instead of twelve 10px dots. */
  .renovations-swiper .swiper-pagination.swiper-pagination-fraction {
    left: auto;
    right: 16px;
    bottom: 16px;
    width: auto;
    padding: 4px 12px;
    border-radius: 9999px;
    background: rgba(15, 23, 42, 0.75);
    color: white;
    font-size: 14px;
    font-weight: 600;
  }

  /* Cinematic effect kenburns */
  @keyframes kenburns {
    0% {
      transform: scale(1) translate(0, 0);
    }
    100% {
      transform: scale(1.08) translate(-1.5%, 1%);
    }
  }
  .renovations-swiper .swiper-slide-active img {
    animation: kenburns 4.5s ease-out forwards;
  }

  /* Tag reveal on the active slide. Visible by default (no JS); fade only
     under reduced motion. */
  .renovations-swiper.swiper-initialized .slide-tag {
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .renovations-swiper.swiper-initialized .swiper-slide-active .slide-tag {
    opacity: 1;
    transition-delay: 0.3s;
  }
  @media (prefers-reduced-motion: no-preference) {
    .renovations-swiper.swiper-initialized .slide-tag {
      transform: translateY(12px);
      transition:
        opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .renovations-swiper.swiper-initialized .swiper-slide-active .slide-tag {
      transform: translateY(0);
    }
  }
</style>

<script>
  import Swiper from "swiper/bundle";
  import "swiper/css/bundle";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const swiper = new Swiper(".renovations-swiper", {
    loop: true,
    effect: "fade",
    fadeEffect: { crossFade: true },
    autoplay: reduce
      ? false
      : {
          delay: 5000,
          disableOnInteraction: false,
          pauseOnMouseEnter: false,
        },
    keyboard: { enabled: true, onlyInViewport: true },
    pagination: { el: ".swiper-pagination", type: "fraction" },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
  });

  // Autoplay is a loop: it runs only while on screen and until paused.
  const slider = document.querySelector<HTMLElement>(".renovations-swiper");
  const toggle = document.querySelector<HTMLButtonElement>(".slideshow-toggle");
  if (!reduce && slider && toggle) {
    let paused = false;
    let onScreen = false;
    const sync = () => {
      if (onScreen && !paused) swiper.autoplay.start();
      else swiper.autoplay.stop();
      toggle.dataset.paused = String(paused);
      toggle.setAttribute(
        "aria-label",
        paused ? "Play slideshow" : "Pause slideshow",
      );
    };
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      paused = !paused;
      sync();
    });
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      sync();
    }).observe(slider);
  }
</script>
