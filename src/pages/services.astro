---
import Layout from "../layouts/Layout.astro";
import ServiceCards from "../components/ServiceCards.astro";
import { SITE, photo } from "../site";

const reasons = [
  "Clean, precise work focused on efficiency and quality",
  "Professional and punctual service throughout Perth",
  "Technical approach ensuring safe removal",
  "Viable options for your renovation project",
];

const videos = [
  {
    src: "https://ik.imagekit.io/137/rosco-sr/video6219997081453470100.mp4",
  },
  {
    src: "https://ik.imagekit.io/137/rosco-sr/video6305415180582919045.mp4",
  },
];

const kitchen = (id: string, stage: "Before" | "After") => ({
  src: photo(`Renovations/${id}.jpg`),
  category: `Kitchen: ${stage}`,
  alt:
    stage === "Before"
      ? "Perth kitchen before renovation, with old cream cabinets and tiles"
      : "The same Perth kitchen after renovation, with new cabinets and a marble-look splashback",
});

const floor = (id: string) => ({
  src: photo(`Renovations/${id}.jpg`),
  category: "Floor Renovation",
  alt: "Renovated floor in a Perth home",
});

// The two kitchen "before" shots and two "after" shots are the same kitchen.
const renovations = [
  kitchen("6257921321014595423", "Before"),
  kitchen("6257921321014595424", "Before"),
  kitchen("6257921321014595405", "After"),
  kitchen("6257921321014595422", "After"),
  floor("6257921321014595431"),
  floor("6257921321014595429"),
  floor("6257921321014595426"),
  floor("6257921321014595430"),
  floor("6257921321014595428"),
  floor("6257921321014595427"),
  floor("6257921321014595433"),
  floor("6257921321014595432"),
];

const pageDescription = `Bathroom strip outs, kitchen removal, floor and tile removal, light demolition and floor grinding across Perth. Free quotes. Call or text ${SITE.phone}.`;
---

<Layout
  title={`Strip Out & Removal Services Perth | ${SITE.name}`}
  description={pageDescription}>
  <!-- Services Section -->
  <section class="bg-surface-alt py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl text-ink">
          Strip Out &amp; Removal Services in Perth
        </h1>
        <p class="mt-4 text-lg leading-8 text-text-body">
          Everything that has to come out before the new work goes in. Pick a
          job to see what's involved.
        </p>
      </div>
      <div class="mx-auto mt-16 max-w-2xl lg:max-w-none">
        <ServiceCards headingTag="h2" />
      </div>
    </div>
  </section>

  <!-- Renovations Section -->
  <section
    id="renovations"
    class="scroll-mt-20 bg-surface-alt py-16 sm:py-24"
    aria-label="Renovations showcase">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center mb-10 sm:mb-16">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-ink">
        Renovations
      </h2>
      <p class="mt-4 text-lg leading-8 text-text-body">
        Kitchens and floors we've renovated around Perth
      </p>
    </div>

    <div
      class="swiper renovations-swiper h-[70vh] sm:h-[80vh] lg:h-[85vh] min-h-[400px] w-full lg:w-3xl shadow-2xl lg:rounded-xl">
      <div class="swiper-wrapper">
        {
          renovations.map((renovation) => (
            <div class="swiper-slide relative h-full w-full">
              <img
                src={renovation.src}
                alt={renovation.alt}
                class="absolute inset-0 h-full w-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
              <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-10 lg:p-16">
                <span class="inline-block rounded-full bg-white/20 backdrop-blur-md px-4 py-2 text-sm font-semibold text-white border border-white/30">
                  {renovation.category}
                </span>
              </div>
            </div>
          ))
        }
      </div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
      <div class="swiper-pagination"></div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="bg-bg-base py-24 sm:py-32" aria-label="Why choose us">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-ink">
          Why Choose Us?
        </h2>
        <dl
          class="mx-auto mt-10 grid max-w-xl gap-6 sm:grid-cols-2 lg:max-w-none lg:grid-cols-4">
          {
            reasons.map((reason, i) => (
              <div
                class="flex flex-col items-center rounded-2xl bg-surface p-6 ring-1 ring-border transition-all duration-500 hover:shadow-xl hover:-translate-y-1"
                style={`animation: fade-in-up 0.6s ease-out ${i * 0.1 + 0.4}s both`}>
                <dt class="text-sm font-semibold leading-6 text-ink">
                  {reason}
                </dt>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <div class="h-px w-full bg-border"></div>

  <!-- Video Section -->
  <section class="bg-bg-base py-24 sm:py-32" aria-label="Video showcase">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl text-ink">
          See Our Work in Action
        </h2>
        <p class="mt-4 text-lg leading-8 text-text-body">
          Watch real footage from our recent projects across Perth.
        </p>
      </div>
      <div
        class="mx-auto mt-12 grid max-w-2xl grid-cols-1 gap-8 sm:grid-cols-2 lg:mx-0 lg:max-w-none">
        {
          videos.map((video) => (
            <div class="flex flex-col items-center gap-4">
              <div class="relative w-full max-w-xs aspect-[9/16] overflow-hidden rounded-2xl bg-[#111827] shadow-lg ring-1 ring-border">
                <video
                  src={video.src}
                  class="absolute inset-0 h-full w-full object-cover"
                  controls
                  playsinline
                  preload="none"
                />
              </div>
            </div>
          ))
        }
      </div>
      <div class="mt-20 text-center">
        <a
          href="/contact/"
          class="group inline-flex items-center gap-3 rounded-xl bg-primary px-10 py-5 text-lg font-bold text-white shadow-xl shadow-primary/30 transition-all duration-300 hover:bg-primary-hover hover:shadow-2xl hover:shadow-primary/40 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary">
          Get a Free Quote <span
            class="inline-block transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .renovations-swiper .swiper-slide {
    background-color: #111827;
    overflow: hidden;
  }

  .renovations-swiper .swiper-button-prev,
  .renovations-swiper .swiper-button-next {
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 9999px;
    color: white !important;
    transition:
      background 0.3s ease,
      transform 0.3s ease;
  }
  .renovations-swiper .swiper-button-prev::after,
  .renovations-swiper .swiper-button-next::after {
    font-size: 16px;
    font-weight: bold;
  }
  .renovations-swiper .swiper-button-prev:hover,
  .renovations-swiper .swiper-button-next:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.05);
  }

  .renovations-swiper .swiper-pagination {
    bottom: 20px !important;
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  .renovations-swiper .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    background: rgba(255, 255, 255, 0.5);
    opacity: 1;
    border-radius: 9999px;
    transition: all 0.3s ease;
  }
  .renovations-swiper .swiper-pagination-bullet-active {
    width: 30px;
    background: white;
  }

  /* Cinematic effect kenburns */
  @keyframes kenburns {
    0% {
      transform: scale(1) translate(0, 0);
    }
    100% {
      transform: scale(1.08) translate(-1.5%, 1%);
    }
  }
  .renovations-swiper .swiper-slide-active img {
    animation: kenburns 4.5s ease-out forwards;
  }

  /*  Text Reveal */
  .renovations-swiper .swiper-slide .absolute.bottom-0 span {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .renovations-swiper .swiper-slide-active .absolute.bottom-0 span {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.3s;
  }
</style>

<script>
  import Swiper from "swiper/bundle";
  import "swiper/css/bundle";

  new Swiper(".renovations-swiper", {
    loop: true,
    effect: "fade",
    fadeEffect: { crossFade: true },
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
      pauseOnMouseEnter: false,
    },
    keyboard: { enabled: true, onlyInViewport: true },
    pagination: { el: ".swiper-pagination", clickable: true },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
  });
</script>
