---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About ROSCO S&R | Perth Strip Out, Removal & Renovation Specialists"
  description="Learn about ROSCO S&R — strip outs, non-structural demolition, kitchen renovations, floor renovations, bathroom and kitchen removal, and surface preparation across Perth, WA."
>
  <section class="bg-bg-base py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div
        class="grid grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2 lg:items-start">
        <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-none">
          <h1
            class="text-3xl font-bold tracking-tight sm:text-4xl text-ink">
            About ROSCO S&R
          </h1>
          <div class="mt-8 space-y-6 text-lg leading-8 text-text-body">
            <p>
              At ROSCO S&R, we specialize in meticulous strip outs, kitchen renovations, floor renovations, and careful removal to preserve the integrity of your fixtures and
              furniture. We understand the value of your assets, so we work with
              the utmost precision to ensure everything is removed respectfully
              and intact.
            </p>
            <p>
              Need a room stripped out or a site cleared before the next trade
              starts? We work with precision and care, and we leave the place
              clean and ready for your next step. Ready to transform your space
              in Perth? Call, email, or send a message for a free quote.
            </p>
          </div>
          <div class="mt-10 flex gap-x-6">
            <a
              href="/contact"
              class="rounded-md px-3.5 py-2.5 text-sm font-semibold text-white bg-primary transition-colors hover:bg-primary-hover focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary">
              Contact Us
            </a>
          </div>
        </div>
        <div
          class="relative overflow-hidden rounded-2xl bg-surface-alt shadow-lg ring-1 ring-border">
          <img
            src="https://ik.imagekit.io/137/rosco-sr/9.webp"
            alt="Work carried out by ROSCO S&R in Perth, Western Australia"
            class="h-auto w-full object-contain"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>
</Layout>