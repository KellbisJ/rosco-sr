---
import Layout from "../layouts/Layout.astro";
import HowItWorks from "../components/HowItWorks.astro";
import { Mail, MapPin, MessageSquareText, Phone } from "@lucide/astro";
import { SITE, quoteText, smsHref } from "../site";

const formUrl = "https://airtable.com/appYhEd6T6ITLN80w/paguCaYXO2AOT1gEv/form";
const inlineLink =
  "rounded font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:text-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
---

<Layout
  title={`Get a Free Quote | ${SITE.name}, Perth`}
  description={`Free quotes for strip outs, removals and renovations in Perth. Call or text ${SITE.phone}, email, or send the details online.`}>
  <section class="bg-surface-alt py-12 sm:py-24" aria-labelledby="quote-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h1
          id="quote-heading"
          class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">
          Get a Free Quote
        </h1>
        <p
          class="mt-4 inline-flex items-center gap-2 rounded-full bg-primary-light px-4 py-1.5 text-sm font-medium text-primary">
          <MapPin class="h-4 w-4" aria-hidden="true" />
          Based in Perth, WA
        </p>
        <p class="mt-4 text-lg leading-8 text-text-body">
          Hard yakka! <span aria-hidden="true">🛠️</span> Tell us what's coming
          out and when. We'll come back with a free, straight quote.
        </p>
      </div>

      <div class="mx-auto mt-10 max-w-md">
        <div class="rounded-2xl bg-surface p-5 ring-1 ring-border sm:p-8">
          <h2 class="text-center text-lg font-semibold text-ink">
            Quickest: call or text
          </h2>
          <div class="mt-6 space-y-3">
            <a
              href={`tel:${SITE.phoneTel}`}
              class="flex min-h-14 w-full flex-wrap items-center justify-center gap-x-3 gap-y-1 rounded-xl bg-primary px-6 py-3 text-center text-white shadow-lg shadow-primary/25 transition-all duration-300 hover:bg-primary-hover active:duration-100 motion-safe:active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
              <Phone class="h-5 w-5" aria-hidden="true" />
              <span class="text-sm font-semibold">Call</span>
              <span class="text-lg font-bold">{SITE.phone}</span>
            </a>
            <a
              href={smsHref(quoteText())}
              class="flex min-h-14 w-full items-center justify-center gap-3 rounded-xl bg-surface px-6 py-3 text-primary ring-1 ring-primary/30 transition-all duration-150 hover:bg-primary-light hover:ring-primary motion-safe:active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
              <MessageSquareText class="h-5 w-5" aria-hidden="true" />
              <span class="text-sm font-semibold">Text us</span>
            </a>
          </div>
          <p class="mt-5 text-center text-sm leading-6 text-text-subtitle">
            <Mail class="mr-1 inline h-4 w-4 align-[-2px] text-primary" aria-hidden="true" />
            Or email{" "}
            <a
              href={`mailto:${SITE.email}?subject=${encodeURIComponent("Quote request")}`}
              class:list={[inlineLink, "break-all"]}>
              {SITE.email}
            </a>
          </p>
          <div class="mt-6 border-t border-border pt-6">
            <h2 class="text-sm font-semibold text-ink">What happens next</h2>
            <div class="mt-4">
              <HowItWorks compact />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    id="quote-form"
    class="scroll-mt-20 bg-bg-base py-16 sm:py-24"
    aria-labelledby="form-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2
          id="form-heading"
          class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          Rather type it out?
        </h2>
        <p class="mt-3 text-base leading-7 text-text-body">
          Send the details online and we'll get back to you.
        </p>
      </div>
      <div class="mx-auto mt-10 max-w-2xl">
        <div class="relative overflow-hidden rounded-2xl bg-surface ring-1 ring-border">
          <!-- Sits behind the iframe; Airtable's opaque form paints over it once
               it renders, and it stays visible if the form is blocked. -->
          <p class="absolute inset-x-0 top-10 text-center text-sm text-text-secondary">
            Loading the form…
          </p>
          <iframe
            class="airtable-embed relative block h-[1640px] w-full sm:h-[1500px]"
            src="https://airtable.com/embed/appYhEd6T6ITLN80w/paguCaYXO2AOT1gEv/form"
            loading="lazy"
            style="background: transparent; border: none;"
            title="Free quote request form">
          </iframe>
        </div>
        <p class="mt-4 text-center text-sm leading-6 text-text-subtitle">
          Form not loading?{" "}
          <a href={formUrl} target="_blank" rel="noopener noreferrer" class={inlineLink}>
            Open it in a new tab
          </a>{" "}
          or{" "}
          <a href={smsHref(quoteText())} class={inlineLink}>text us</a>.
        </p>
      </div>
    </div>
  </section>

