---
import Layout from "../layouts/Layout.astro";
import { Mail, MessageSquareText, Phone } from "@lucide/astro";
import { SITE } from "../site";

const channels = [
  { label: "Call us", value: SITE.phone, href: `tel:${SITE.phoneTel}`, icon: Phone },
  { label: "Text us", value: SITE.phone, href: `sms:${SITE.phoneTel}`, icon: MessageSquareText },
  { label: "Email us", value: SITE.email, href: `mailto:${SITE.email}`, icon: Mail },
];
---

<Layout
  title={`Get a Free Quote | ${SITE.name}, Perth`}
  description={`Free quotes for strip outs, removals and renovations in Perth. Call or text ${SITE.phone}, email, or send the details online.`}>
  <!-- Hero with direct contact -->
  <section class="relative overflow-hidden bg-surface-alt py-24 sm:py-32">
    <!-- Google Maps background -->
    <div class="absolute inset-0 z-0 opacity-40 pointer-events-none">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d432910.83790986397!2d115.63121060437139!3d-32.03905359437239!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2a32966cdb47733d%3A0x304f0b535df55d0!2sPerth%20WA%2C%20Australia!5e0!3m2!1sen!2sve!4v1777482079192!5m2!1sen!2sve"
        width="100%"
        height="100%"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Map of Perth, Australia">
      </iframe>
    </div>
    <!-- Overlay to maintain readability -->
    <div class="absolute inset-0 z-[1] bg-surface-alt/60"></div>

    <!-- Bottom fade separator -->
    <div
      class="absolute bottom-0 left-0 right-0 z-[2] h-48 bg-gradient-to-b from-transparent to-bg-base pointer-events-none">
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl text-ink">
          Get a Free Quote
        </h1>
        <div
          class="mt-4 inline-flex items-center gap-2 rounded-full bg-primary-light px-4 py-1.5 text-sm font-medium text-primary">
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z">
            </path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z">
            </path>
          </svg>
          Based in Perth, WA
        </div>
        <p class="mt-4 text-lg leading-8 text-text-body">
          Hard yakka! 🛠️ Tell us what's coming out and when. We'll come back
          with a free, straight quote.
        </p>
      </div>

      <!-- Direct Contact -->
      <div class="mx-auto mt-12 max-w-xl">
        <div class="rounded-2xl bg-surface p-5 ring-1 ring-border sm:p-8">
          <h2 class="text-center text-lg font-semibold text-ink">
            Reach us directly
          </h2>
          <div class="mt-6 space-y-4">
            {
              channels.map((c) => (
                <a
                  href={c.href}
                  class="flex items-center gap-4 rounded-xl bg-surface-alt px-5 py-4 text-sm text-text-body transition-colors hover:bg-primary-light hover:text-primary focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-primary">
                  <c.icon class="h-5 w-5 flex-shrink-0 text-primary" aria-hidden="true" />
                  <span class="flex min-w-0 flex-1 flex-col sm:flex-row sm:items-center sm:gap-4">
                    <span class="font-medium">{c.label}</span>
                    <span class="text-text-subtitle [overflow-wrap:anywhere] sm:ml-auto sm:text-right">{c.value}</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Online form -->
  <section class="bg-bg-base pb-24 sm:pb-32" aria-labelledby="quote-form">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2
          id="quote-form"
          class="text-3xl font-bold tracking-tight sm:text-4xl text-ink">
          Or send the details online
        </h2>
      </div>
      <div class="mx-auto mt-12 max-w-2xl">
        <div class="overflow-hidden rounded-2xl bg-surface ring-1 ring-border">
          <iframe
            class="airtable-embed"
            src="https://airtable.com/embed/appYhEd6T6ITLN80w/paguCaYXO2AOT1gEv/form"
            frameborder="0"
            width="100%"
            height="768"
            style="background: transparent; border: none;"
            title="Free quote request form">
          </iframe>
        </div>
      </div>

