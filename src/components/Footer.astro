---
// src/components/Footer.astro
import { SITE, nb, quoteText, smsHref } from "../site";
import { services } from "../data/services";

const footerLinks = {
  company: [
    { label: `About ${SITE.name}`, href: "/about/" },
    { label: "All services", href: "/services/" },
    { label: "Kitchen & floor renovations", href: "/services/#renovations" },
  ],
  services: services.map((s) => ({
    label: nb(s.name),
    href: `/services/${s.slug}/`,
  })),
  contact: [
    { label: `Call ${SITE.phone}`, href: `tel:${SITE.phoneTel}` },
    { label: `Text ${SITE.phone}`, href: smsHref(quoteText()) },
    { label: SITE.email, href: `mailto:${SITE.email}` },
    { label: "Get a Free Quote", href: "/contact/#quote-form" },
  ],
};
---

<footer class="border-t bg-surface py-12 border-border">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-text-secondary">
          {SITE.name}
        </h2>
        <p class="mt-4 text-sm leading-6 text-text-secondary">
          Strip outs, removals, non-structural demolition, and kitchen and floor
          renovations in Perth, Western Australia.
        </p>
      </div>
      {
        Object.entries(footerLinks).map(([category, links]) => (
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-text-secondary">
              {category}
            </h2>
            <ul class="mt-4 space-y-2" aria-label={`${category} links`}>
              {links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="block break-words max-md:py-3 text-sm text-secondary transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-12 border-t pt-8 border-border">
      <p class="text-xs text-center text-text-secondary">
        &copy; {new Date().getFullYear()} {SITE.name}. All rights reserved. Perth, Western
        Australia.
      </p>
    </div>
  </div>
</footer>
