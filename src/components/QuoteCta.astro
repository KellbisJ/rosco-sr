---
import CtaButtons from "./CtaButtons.astro";

interface Props {
  heading: string;
  body?: string;
}

const {
  heading,
  body = "Tell us what's coming out and when. We'll come back with a free, straight quote.",
} = Astro.props;
---

<section class="bg-bg-base py-20 sm:py-28" aria-label="Get a quote">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-balance text-ink sm:text-4xl">
        {heading}
      </h2>
      <p class="mt-4 text-lg leading-7 text-text-body">{body}</p>
      <CtaButtons class="mt-10 justify-center" />
    </div>
  </div>
</section>
