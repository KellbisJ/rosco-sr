---
import { Menu, Phone, X } from "@lucide/astro";
import { SITE, quoteText, smsHref } from "../site";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];

const logo = SITE.logo;

// Marked at build time, so it works without JS.
const here = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? here === "/" : here.startsWith(href);
const navClass = (href: string) =>
  isActive(href) ? "font-semibold text-primary" : "text-secondary";
---

<header
  class="sticky top-0 z-50 w-full border-b bg-surface/80 backdrop-blur-sm border-border [view-transition-name:site-header]">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-y-1 px-2 py-2 sm:px-4">
    <a
      href="/"
      class="inline-flex min-h-11 shrink-0 items-center leading-none rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      aria-label={`${SITE.name} home`}>
      <img
        src={logo}
        alt={`${SITE.name} - Strip Outs & Removals Perth`}
        width="848"
        height="249"
        class="h-9 w-auto object-contain min-[380px]:h-10 sm:h-12" />
    </a>
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "inline-flex items-center rounded-md px-1 py-2 text-sm font-medium transition-colors hover:text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
              navClass(link.href),
            ]}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-1 sm:gap-2">
      <a
        href={`tel:${SITE.phoneTel}`}
        aria-label={`Call ${SITE.phone}`}
        class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-md px-2 text-sm font-semibold text-primary transition-colors hover:text-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        <Phone class="h-5 w-5" aria-hidden="true" />
        <span class="hidden lg:inline">{SITE.phone}</span>
      </a>
      <a
        href="/contact/#quote-form"
        class="min-h-11 inline-flex items-center justify-center rounded-md px-3 py-2 text-sm font-semibold text-white bg-primary transition duration-150 hover:bg-primary-hover motion-safe:active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:px-4">
        Get a Quote
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="group md:hidden inline-flex h-11 w-11 items-center justify-center rounded-md text-secondary transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu">
        <Menu class="h-6 w-6 group-aria-expanded:hidden" aria-hidden="true" />
        <X class="hidden h-6 w-6 group-aria-expanded:block" aria-hidden="true" />
      </button>
    </div>
  </div>
  <div
    id="mobile-menu"
    class="absolute inset-x-0 top-full z-40 hidden md:hidden bg-surface shadow-lg ring-1 ring-border">
    <nav class="border-t border-border" aria-label="Mobile navigation">
      <ul class="divide-y divide-border">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "flex min-h-11 items-center px-4 text-sm font-medium transition-colors hover:bg-primary-light/60 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
                  navClass(link.href),
                ]}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={`tel:${SITE.phoneTel}`}
            class="flex min-h-11 items-center px-4 text-sm font-medium text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            Call <span class="ml-1">{SITE.phone}</span>
          </a>
        </li>
        <li>
          <a
            href={smsHref(quoteText())}
            class="flex min-h-11 items-center px-4 text-sm font-medium text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            Text <span class="ml-1">{SITE.phone}</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style is:global>
  /* The menu fades (and, motion allowing, drops 6px) in; it leaves faster. */
  #mobile-menu {
    transition-property: opacity, display;
    transition-duration: 200ms;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    transition-behavior: allow-discrete;
  }
  #mobile-menu.hidden {
    opacity: 0;
    transition-duration: 120ms;
  }
  @starting-style {
    #mobile-menu {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    #mobile-menu {
      transition-property: opacity, translate, display;
    }
    #mobile-menu.hidden {
      translate: 0 -6px;
    }
    @starting-style {
      #mobile-menu {
        translate: 0 -6px;
      }
    }
  }
</style>

<script is:inline>
  // Lets iOS Safari show :active press states on links and buttons.
  document.addEventListener("touchstart", () => {}, { passive: true });

  (() => {
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggle || !menu) return;

    const close = (restoreFocus) => {
      if (menu.classList.contains("hidden")) return;
      menu.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
      if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener("click", () => {
      if (menu.classList.contains("hidden")) {
        menu.classList.remove("hidden");
        toggle.setAttribute("aria-expanded", "true");
        toggle.setAttribute("aria-label", "Close menu");
      } else {
        close(false);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) close(true);
    });

    document.addEventListener("click", (e) => {
      if (
        !menu.classList.contains("hidden") &&
        !menu.contains(e.target) &&
        !toggle.contains(e.target)
      ) {
        close(false);
      }
    });
  })();
</script>